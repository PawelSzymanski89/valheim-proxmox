# Copy to .env next to docker-compose.yml. Every value is optional; these are the defaults.
# Read once, on the first start - afterwards the panel owns the settings (Settings tab).
CONTAINER_NAME=valheim
GAME_PORT=2456          # udp; the game also takes GAME_PORT+1
PANEL_PORT=2460         # tcp
SERVER_NAME=Valheim
WORLD_NAME=Dedicated
SERVER_PASS=valheim123  # players need it to join, at least 5 characters
PANEL_USER=admin
PANEL_PASS=valheim123
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=            # empty = a random one, shown in the panel
